    <string name="rumi_section_web_search">網路搜尋</string>
    <string name="rumi_web_search_note">讓助手去查資料，而不是憑記憶回答。選填：沒有金鑰時，這個工具根本不會提供給模型。</string>
    <string name="rumi_search_web">搜尋網路</string>
