    <!-- AI services settings block -->
    <string name="rumi_ai_title">AI 服務</string>
    <string name="rumi_ai_intro">選填。它們讓助手能夠生成語音、音效、圖片和影片，而不只是描述。只有當服務已開啟且配有金鑰時，工具才會提供給模型；未設定的服務不會被提及，因此它無法假裝可用。金鑰用這裡的按鈕儲存。</string>
    <string name="rumi_ai_empty">尚未設定任何服務。</string>
    <string name="rumi_ai_key_support">依服務分別儲存。用上面的按鈕儲存。</string>
    <string name="rumi_field_base_url_override">覆寫基礎 URL</string>
    <string name="rumi_field_model_override">覆寫模型</string>
    <string name="rumi_field_model">模型</string>
    <string name="rumi_ai_required_hint">自行新增的服務必填</string>
    <string name="rumi_ai_remove">刪除此服務</string>
    <string name="rumi_ai_custom_title">你自己的服務</string>
    <string name="rumi_ai_custom_intro">把助手指向你掌控的 OpenAI 相容端點——自己的伺服器或代理。語音發往 `{base}/audio/speech`，圖片發往 `{base}/images/generations`。影片和音效無法在這裡新增：沒有可填寫的相容請求格式。</string>
    <string name="rumi_ai_produces">生成</string>
    <string name="rumi_add">新增</string>
    <string name="rumi_ai_kind_speech">語音（文字轉語音）</string>
    <string name="rumi_ai_kind_sound">音效</string>
    <string name="rumi_ai_kind_image">圖片</string>
    <string name="rumi_ai_kind_video">影片</string>
    <string name="rumi_ai_kind_speech_note">把文字變成配音。就緒的服務會作為 `speak` 工具提供給模型，它把音訊作為圖層寫入專案。</string>
    <string name="rumi_ai_kind_sound_note">沒有內建的音效服務，這裡也無法新增：目前沒有既能使用有文件的請求格式、又允許在手機應用程式裡使用金鑰的服務商。在以其他方式設定之前，`generate_sound` 工具不會提供給模型。</string>
    <string name="rumi_ai_kind_image_note">繪製圖片。就緒的服務會作為 `generate_image` 工具提供，它把檔案寫入專案並新增為圖片圖層。</string>
    <string name="rumi_ai_kind_video_note">渲染短片。就緒的服務會作為 `generate_video` 工具提供。渲染是非同步的，因此耗時較長的渲染會傳回一個任務名稱，供下次呼叫取回，而不是直接失敗。</string>
    <string name="rumi_ai_status_no_key">填入金鑰即可開啟</string>
    <string name="rumi_ai_status_no_url">填入基礎 URL 即可開啟</string>
    <string name="rumi_ai_status_no_model">填入模型即可開啟</string>
    <!-- %1$s — the model id. -->
    <string name="rumi_ai_status_ready">%1$s · 就緒</string>
    <string name="rumi_ai_status_off">%1$s · 金鑰已儲存，已關閉</string>

    <!-- One-line descriptions of the built-in providers, shown in the settings. -->
    <string name="rumi_provider_note_opencode_go">為第三方程式設計代理打造的訂閱閘道。每次安裝需要一個固定的工作階段 ID。</string>
    <string name="rumi_provider_note_opencode_zen">按量付費閘道。協定與 Go 相同，按 token 計費。</string>
    <string name="rumi_provider_note_gemini">透過 Google 的 OpenAI 相容端點存取。</string>
    <string name="rumi_provider_note_anthropic">使用 Messages 協定；推理和工具呼叫有各自的格式。</string>
    <string name="rumi_provider_note_openai">Chat Completions。工具呼叫可用；不傳送工作階段 ID。</string>
    <string name="rumi_provider_note_custom">任意 OpenAI 相容端點：自建伺服器、代理，或者這個版本從未聽說過的閘道。</string>

    <!-- One-line descriptions of the built-in generation services. -->
    <string name="rumi_ai_note_gemini_speech">30 個預設音色，傳回 WAV。免費額度已涵蓋語音合成。</string>
    <string name="rumi_ai_note_openai_speech">13 個音色，傳回 MP3。`instructions` 僅在該模型上生效。</string>
    <string name="rumi_ai_note_gemini_image">Nano Banana，1K/2K/4K。沒有免費額度：金鑰必須屬於已開啟帳單的專案。</string>
    <string name="rumi_ai_note_openai_image">GPT 圖像模型始終傳回 base64，不傳回連結。</string>
    <string name="rumi_ai_note_veo">非同步渲染（11 秒到約 6 分鐘）。僅付費層級可用。</string>
    <string name="rumi_ai_note_seedance">BytePlus ModelArk，字節跳動自家的 API。非同步渲染；生成的連結只保留 24 小時，因此任務一結束就會下載。</string>

