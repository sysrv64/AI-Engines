    <string name="rumi_field_models_path">模型清單路徑</string>
    <string name="rumi_models_path_hint">附加到基礎 URL 之後。OpenAI 形式的伺服器保持 /models。</string>
    <string name="rumi_field_capability">models.dev 服務商鍵</string>
    <string name="rumi_capability_hint">選填。不填時，模型會被視為一般對話模型。</string>
    <string name="rumi_session_header">傳送工作階段 ID</string>
    <string name="rumi_session_header_hint">有些閘道要求固定的 x-opencode-session 請求標頭。</string>
    <string name="rumi_section_snapshots">上下文中保留的快照</string>
