<?xml version="1.0" encoding="utf-8"?>
<!--
  The assistant tab: the chat screen, its settings blocks and the sub-agent view.

  Model-facing text is deliberately absent from this file: tool descriptions, the
  progress notes that go back to the model and the protocol tokens written into the
  settings file are not read by people, and translating them would change what the
  model or the gateway sees.
-->
<resources>

    <!-- Rumi settings block -->
    <string name="rumi_settings_intro">內建助手。將它指向任意服務商，從該服務商讀取即時模型清單，而它只能透過自己的工具動手。</string>
    <string name="rumi_section_provider">服務商</string>
    <!-- Appended to the name of a provider the user added, in the provider chips. -->
    <string name="rumi_custom_suffix">（自訂）</string>
    <string name="rumi_field_api_key">API 金鑰</string>
    <string name="rumi_field_name">名稱</string>
    <string name="rumi_field_base_url">基礎 URL</string>
    <string name="rumi_base_url_hint">寫到版本段為止，例如 https://host/v1</string>
    <!-- %1$s — the provider's name. -->
    <string name="rumi_key_support">由 %1$s 簽發的金鑰。依服務商分別儲存，切換時不會遺失另一個。</string>
    <string name="rumi_field_endpoint">覆寫端點</string>
