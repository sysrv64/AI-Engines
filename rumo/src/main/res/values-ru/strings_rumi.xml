<?xml version="1.0" encoding="utf-8"?>
<!--
  The assistant tab: the chat screen, its settings blocks and the sub-agent view.

  Model-facing text is deliberately absent from this file: tool descriptions, the
  progress notes that go back to the model and the protocol tokens written into the
  settings file are not read by people, and translating them would change what the
  model or the gateway sees.
-->
<resources>

    <!-- Rumi settings block -->
    <string name="rumi_settings_intro">Встроенный ассистент. Укажите ему любого провайдера, читайте живой список моделей у него же — и действовать он сможет только своими инструментами.</string>
    <string name="rumi_section_provider">Провайдер</string>
    <!-- Appended to the name of a provider the user added, in the provider chips. -->
    <string name="rumi_custom_suffix"> (свой)</string>
    <string name="rumi_field_api_key">Ключ API</string>
    <string name="rumi_field_name">Название</string>
    <string name="rumi_field_base_url">Базовый URL</string>
    <string name="rumi_base_url_hint">До сегмента версии, например https://host/v1</string>
    <!-- %1$s — the provider's name. -->
    <string name="rumi_key_support">Ключ, выданный %1$s. Хранится отдельно для каждого провайдера, поэтому при переключении второй не теряется.</string>
    <string name="rumi_field_endpoint">Переопределение адреса</string>
    <string name="rumi_endpoint_required">Требуется для своего провайдера</string>
    <string name="rumi_field_protocol">Протокол</string>
    <string name="rumi_field_credential">Аутентификация</string>
    <string name="rumi_field_header_name">Имя заголовка</string>
    <string name="rumi_field_models_path">Путь к списку моделей</string>
    <string name="rumi_models_path_hint">Добавляется к базовому URL. Оставьте /models для серверов в стиле OpenAI.</string>
    <string name="rumi_field_capability">Ключ провайдера в models.dev</string>
    <string name="rumi_capability_hint">Необязательно. Без него модели считаются обычными текстовыми.</string>
    <string name="rumi_session_header">Отправлять идентификатор сессии</string>
    <string name="rumi_session_header_hint">Некоторые шлюзы требуют постоянный заголовок x-opencode-session.</string>
    <string name="rumi_section_snapshots">Снимки в контексте</string>
    <string name="rumi_snapshots_note">Старые изображения отбрасываются из запроса; их текстовые результаты остаются.</string>
    <string name="rumi_none">нет</string>
    <string name="rumi_section_web_search">Поиск в интернете</string>
    <string name="rumi_web_search_note">Позволяет ассистенту искать, а не отвечать по памяти. Необязательно: без ключа инструмент вообще не предлагается модели.</string>
    <string name="rumi_search_web">Искать в интернете</string>
    <string name="rumi_search_add_key">Добавьте ключ Exa, чтобы включить</string>
    <string name="rumi_search_ready">Exa · готово</string>
    <string name="rumi_search_saved_off">Exa · ключ сохранён, выключено</string>
    <string name="rumi_field_exa_key">Ключ API Exa</string>
    <string name="rumi_saved">Сохранено</string>

    <!-- AI services settings block -->
    <string name="rumi_ai_title">AI-сервисы</string>
    <string name="rumi_ai_intro">Необязательно. Они позволяют ассистенту создавать речь, звук, изображения и видео, а не только описывать их. Инструмент предлагается модели только тогда, когда его сервис включён и у него есть ключ; ненастроенный не упоминается вовсе, поэтому выдать себя за доступный он не может. Ключи сохраняются кнопкой здесь.</string>
    <string name="rumi_ai_empty">Пока ничего не настроено.</string>
    <string name="rumi_ai_key_support">Хранится отдельно для каждого сервиса. Сохраняется кнопкой выше.</string>
    <string name="rumi_field_base_url_override">Переопределение базового URL</string>
    <string name="rumi_field_model_override">Переопределение модели</string>
    <string name="rumi_field_model">Модель</string>
    <string name="rumi_ai_required_hint">Требуется для добавленного вами сервиса</string>
    <string name="rumi_ai_remove">Удалить этот сервис</string>
    <string name="rumi_ai_custom_title">Свой сервис</string>
    <string name="rumi_ai_custom_intro">Укажите ассистенту подконтрольную вам OpenAI-совместимую точку входа — свой сервер или прокси. Речь отправляется в `{base}/audio/speech`, изображения — в `{base}/images/generations`. Видео и звук здесь не добавить: подходящей формы запроса для них нет.</string>
    <string name="rumi_ai_produces">Создаёт</string>
    <string name="rumi_add">Добавить</string>
    <string name="rumi_ai_kind_speech">Речь (текст в голос)</string>
    <string name="rumi_ai_kind_sound">Звуковые эффекты</string>
    <string name="rumi_ai_kind_image">Изображения</string>
    <string name="rumi_ai_kind_video">Видео</string>
    <string name="rumi_ai_kind_speech_note">Превращает текст в озвучку. Готовый сервис предлагается модели как инструмент `speak`, который записывает звук в проект отдельным слоем.</string>
    <string name="rumi_ai_kind_sound_note">Готового сервиса звука нет, и добавить его здесь нельзя: неизвестен провайдер, который одновременно использует документированную форму запроса и допускает ключ из мобильного приложения. Пока он не настроен другим способом, инструмент `generate_sound` модели не предлагается вовсе.</string>
    <string name="rumi_ai_kind_image_note">Рисует картинки. Готовый сервис предлагается как инструмент `generate_image`: он записывает файл в проект и добавляет его слоем-изображением.</string>
    <string name="rumi_ai_kind_video_note">Рендерит короткие клипы. Готовый сервис предлагается как инструмент `generate_video`. Рендер асинхронный, поэтому долгий запрос отвечает именем задачи, которую надо забрать следующим вызовом, а не ошибкой.</string>
    <string name="rumi_ai_status_no_key">Добавьте ключ, чтобы включить</string>
    <string name="rumi_ai_status_no_url">Добавьте базовый URL, чтобы включить</string>
    <string name="rumi_ai_status_no_model">Добавьте модель, чтобы включить</string>
    <!-- %1$s — the model id. -->
    <string name="rumi_ai_status_ready">%1$s · готово</string>
    <string name="rumi_ai_status_off">%1$s · ключ сохранён, выключено</string>

    <!-- One-line descriptions of the built-in providers, shown in the settings. -->
    <string name="rumi_provider_note_opencode_go">Шлюз по подписке для сторонних агентов-программистов. Нужен один постоянный идентификатор сессии на установку.</string>
    <string name="rumi_provider_note_opencode_zen">Шлюз с оплатой по факту. Тот же протокол, что у Go, но счёт идёт за токены.</string>
    <string name="rumi_provider_note_gemini">Доступен через OpenAI-совместимую точку входа Google.</string>
    <string name="rumi_provider_note_anthropic">Говорит по протоколу Messages; у рассуждений и вызовов инструментов своя форма.</string>
    <string name="rumi_provider_note_openai">Chat Completions. Вызовы инструментов работают; идентификатор сессии не отправляется.</string>
    <string name="rumi_provider_note_custom">Любая OpenAI-совместимая точка входа: свой сервер, прокси или шлюз, о котором эта сборка не слышала.</string>

    <!-- One-line descriptions of the built-in generation services. -->
    <string name="rumi_ai_note_gemini_speech">30 готовых голосов, на выходе WAV. Бесплатный тариф покрывает синтез речи.</string>
    <string name="rumi_ai_note_openai_speech">13 голосов, на выходе MP3. `instructions` работает только в этой модели.</string>
    <string name="rumi_ai_note_gemini_image">Nano Banana, 1K/2K/4K. Бесплатного тарифа нет: ключ должен быть у проекта с включённой оплатой.</string>
    <string name="rumi_ai_note_openai_image">Модели GPT для изображений всегда возвращают base64, а не ссылку.</string>
    <string name="rumi_ai_note_veo">Рендерится асинхронно (от 11 с до ~6 мин). Только платный тариф.</string>
    <string name="rumi_ai_note_seedance">BytePlus ModelArk, собственный API ByteDance. Рендерится асинхронно; готовая ссылка живёт 24 часа, поэтому файл скачивается сразу по завершении задачи.</string>

