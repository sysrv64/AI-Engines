    <string name="rumi_base_url_hint">Up to the version segment, e.g. https://host/v1</string>
    <!-- %1$s — the provider's name. -->
    <string name="rumi_key_support">A key minted by %1$s. Stored per provider, so switching does not lose the other one.</string>
