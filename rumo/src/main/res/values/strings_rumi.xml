    <string name="rumi_field_capability">models.dev provider key</string>
    <string name="rumi_capability_hint">Optional. Without it, models are assumed to be plain chat models.</string>
    <string name="rumi_session_header">Send a session id</string>
    <string name="rumi_session_header_hint">Some gateways require a stable x-opencode-session header.</string>
