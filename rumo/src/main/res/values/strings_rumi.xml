    <!-- AI services settings block -->
    <string name="rumi_ai_title">AI services</string>
    <string name="rumi_ai_intro">Optional. These let the assistant create speech, sound, pictures and video instead of only describing them. A tool is offered to the model only when its service is switched on and has a key — an unconfigured one is never mentioned, so it cannot pretend to be available. Keys are saved with the button here.</string>
    <string name="rumi_ai_empty">Nothing configured yet.</string>
    <string name="rumi_ai_key_support">Stored per service. Saved with the button above.</string>
    <string name="rumi_field_base_url_override">Base URL override</string>
    <string name="rumi_field_model_override">Model override</string>
    <string name="rumi_field_model">Model</string>
    <string name="rumi_ai_required_hint">Required for a service you added</string>
    <string name="rumi_ai_remove">Remove this service</string>
    <string name="rumi_ai_custom_title">Your own service</string>
    <string name="rumi_ai_custom_intro">Point the assistant at an OpenAI-compatible endpoint you control — your own server, or a proxy you run. Speech posts to `{base}/audio/speech`, images to `{base}/images/generations`. Video and sound cannot be added here: there is no compatible shape to fill in.</string>
    <string name="rumi_ai_produces">Produces</string>
    <string name="rumi_add">Add</string>
    <string name="rumi_ai_kind_speech">Speech (text to voice)</string>
    <string name="rumi_ai_kind_sound">Sound effects</string>
    <string name="rumi_ai_kind_image">Images</string>
    <string name="rumi_ai_kind_video">Video</string>
    <string name="rumi_ai_kind_speech_note">Turns text into a voice-over. A ready service is offered to the model as the `speak` tool, which writes the audio into the project as a layer.</string>
    <string name="rumi_ai_kind_sound_note">No sound service is built in and none can be added here: no provider is known that both speaks a documented request shape and allows a key to be used from a mobile app. Until one is configured another way, the `generate_sound` tool is never offered to the model.</string>
    <string name="rumi_ai_kind_image_note">Draws pictures. A ready service is offered as the `generate_image` tool, which writes the file into the project and adds it as an image layer.</string>
    <string name="rumi_ai_kind_video_note">Renders short clips. A ready service is offered as the `generate_video` tool. Rendering is asynchronous, so a long render answers with a job name to collect on the next call instead of failing.</string>
    <string name="rumi_ai_status_no_key">Add a key to switch this on</string>
    <string name="rumi_ai_status_no_url">Add a base URL to switch this on</string>
    <string name="rumi_ai_status_no_model">Add a model to switch this on</string>
    <!-- %1$s — the model id. -->
    <string name="rumi_ai_status_ready">%1$s · ready</string>
    <string name="rumi_ai_status_off">%1$s · key saved, switched off</string>

    <!-- One-line descriptions of the built-in providers, shown in the settings. -->
    <string name="rumi_provider_note_opencode_go">Subscription gateway built for third-party coding agents. One stable session id per install is required.</string>
    <string name="rumi_provider_note_opencode_zen">Pay-as-you-go gateway. Same protocol as Go, billed per token.</string>
    <string name="rumi_provider_note_gemini">Reached through Google\'s OpenAI-compatible endpoint.</string>
    <string name="rumi_provider_note_anthropic">Speaks the Messages protocol; reasoning and tool calls have their own shape.</string>
    <string name="rumi_provider_note_openai">Chat Completions. Tool calls work; no session id is sent.</string>
    <string name="rumi_provider_note_custom">Any OpenAI-compatible endpoint: a self-hosted server, a proxy, or a gateway this build has never heard of.</string>

    <!-- One-line descriptions of the built-in generation services. -->
    <string name="rumi_ai_note_gemini_speech">30 prebuilt voices, returns a WAV. The free tier covers TTS.</string>
    <string name="rumi_ai_note_openai_speech">13 voices, returns MP3. `instructions` works only on this model.</string>
    <string name="rumi_ai_note_gemini_image">Nano Banana, 1K/2K/4K. No free tier: the key must be on a billing-enabled project.</string>
    <string name="rumi_ai_note_openai_image">GPT image models always return base64, never a link.</string>
    <string name="rumi_ai_note_veo">Renders asynchronously (11 s to ~6 min). Paid tier only.</string>
    <string name="rumi_ai_note_seedance">BytePlus ModelArk, ByteDance\'s own API. Renders asynchronously; the finished link lives 24 hours, so it is downloaded as soon as the job ends.</string>

