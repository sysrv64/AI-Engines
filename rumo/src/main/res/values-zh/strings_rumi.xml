    <string name="rumi_saved">已保存</string>

    <!-- AI services settings block -->
    <string name="rumi_ai_title">AI 服务</string>
    <string name="rumi_ai_intro">可选。它们让助手能够生成语音、音效、图片和视频，而不只是描述。只有当服务已开启且配有密钥时，工具才会提供给模型；未配置的服务不会被提及，因此它无法假装可用。密钥用这里的按钮保存。</string>
    <string name="rumi_ai_empty">尚未配置任何服务。</string>
    <string name="rumi_ai_key_support">按服务分别保存。用上面的按钮保存。</string>
    <string name="rumi_field_base_url_override">覆盖基础 URL</string>
    <string name="rumi_field_model_override">覆盖模型</string>
    <string name="rumi_field_model">模型</string>
    <string name="rumi_ai_required_hint">自行添加的服务必填</string>
    <string name="rumi_ai_remove">删除此服务</string>
    <string name="rumi_ai_custom_title">你自己的服务</string>
    <string name="rumi_ai_custom_intro">把助手指向你掌控的 OpenAI 兼容端点——自己的服务器或代理。语音发往 `{base}/audio/speech`，图片发往 `{base}/images/generations`。视频和音效无法在这里添加：没有可填写的兼容请求格式。</string>
    <string name="rumi_ai_produces">生成</string>
    <string name="rumi_add">添加</string>
    <string name="rumi_ai_kind_speech">语音（文字转语音）</string>
    <string name="rumi_ai_kind_sound">音效</string>
    <string name="rumi_ai_kind_image">图片</string>
    <string name="rumi_ai_kind_video">视频</string>
    <string name="rumi_ai_kind_speech_note">把文字变成配音。就绪的服务会作为 `speak` 工具提供给模型，它把音频作为图层写入项目。</string>
    <string name="rumi_ai_kind_sound_note">没有内置的音效服务，这里也无法添加：目前没有既能使用有文档的请求格式、又允许在手机应用里使用密钥的服务商。在以其他方式配置之前，`generate_sound` 工具不会提供给模型。</string>
    <string name="rumi_ai_kind_image_note">绘制图片。就绪的服务会作为 `generate_image` 工具提供，它把文件写入项目并添加为图片图层。</string>
    <string name="rumi_ai_kind_video_note">渲染短片。就绪的服务会作为 `generate_video` 工具提供。渲染是异步的，因此耗时较长的渲染会返回一个任务名，供下次调用取回，而不是直接失败。</string>
    <string name="rumi_ai_status_no_key">填入密钥即可开启</string>
    <string name="rumi_ai_status_no_url">填入基础 URL 即可开启</string>
    <string name="rumi_ai_status_no_model">填入模型即可开启</string>
    <!-- %1$s — the model id. -->
    <string name="rumi_ai_status_ready">%1$s · 就绪</string>
    <string name="rumi_ai_status_off">%1$s · 密钥已保存，已关闭</string>

    <!-- One-line descriptions of the built-in providers, shown in the settings. -->
    <string name="rumi_provider_note_opencode_go">为第三方编程代理打造的订阅网关。每次安装需要一个固定的会话 ID。</string>
    <string name="rumi_provider_note_opencode_zen">按量付费网关。协议与 Go 相同，按 token 计费。</string>
    <string name="rumi_provider_note_gemini">通过 Google 的 OpenAI 兼容端点访问。</string>
    <string name="rumi_provider_note_anthropic">使用 Messages 协议；推理和工具调用有各自的格式。</string>
    <string name="rumi_provider_note_openai">Chat Completions。工具调用可用；不发送会话 ID。</string>
    <string name="rumi_provider_note_custom">任意 OpenAI 兼容端点：自建服务器、代理，或者这个版本从未听说过的网关。</string>

    <!-- One-line descriptions of the built-in generation services. -->
    <string name="rumi_ai_note_gemini_speech">30 个预置音色，返回 WAV。免费额度已覆盖语音合成。</string>
    <string name="rumi_ai_note_openai_speech">13 个音色，返回 MP3。`instructions` 仅在该模型上生效。</string>
    <string name="rumi_ai_note_gemini_image">Nano Banana，1K/2K/4K。没有免费额度：密钥必须属于已开启结算的项目。</string>
    <string name="rumi_ai_note_openai_image">GPT 图像模型始终返回 base64，不返回链接。</string>
    <string name="rumi_ai_note_veo">异步渲染（11 秒到约 6 分钟）。仅付费层级可用。</string>
    <string name="rumi_ai_note_seedance">BytePlus ModelArk，字节跳动自家的 API。异步渲染；生成的链接只保留 24 小时，因此任务一结束就会下载。</string>

