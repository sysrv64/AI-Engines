    <string name="rumi_section_web_search">网络搜索</string>
    <string name="rumi_web_search_note">让助手去查资料，而不是凭记忆回答。可选：没有密钥时，这个工具根本不会提供给模型。</string>
    <string name="rumi_search_web">搜索网络</string>
    <string name="rumi_search_add_key">填入 Exa 密钥即可启用</string>
    <string name="rumi_search_ready">Exa · 就绪</string>
