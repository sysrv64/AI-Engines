<?xml version="1.0" encoding="utf-8"?>
<!--
  The assistant tab: the chat screen, its settings blocks and the sub-agent view.

  Model-facing text is deliberately absent from this file: tool descriptions, the
  progress notes that go back to the model and the protocol tokens written into the
  settings file are not read by people, and translating them would change what the
  model or the gateway sees.
-->
<resources>

    <!-- Rumi settings block -->
    <string name="rumi_settings_intro">内置助手。把它指向任意服务商，从该服务商读取实时模型列表，而它只能通过自己的工具动手。</string>
    <string name="rumi_section_provider">服务商</string>
    <!-- Appended to the name of a provider the user added, in the provider chips. -->
    <string name="rumi_custom_suffix">（自定义）</string>
    <string name="rumi_field_api_key">API 密钥</string>
    <string name="rumi_field_name">名称</string>
    <string name="rumi_field_base_url">基础 URL</string>
    <string name="rumi_base_url_hint">写到版本段为止，例如 https://host/v1</string>
    <!-- %1$s — the provider's name. -->
    <string name="rumi_key_support">由 %1$s 签发的密钥。按服务商分别保存，切换时不会丢掉另一个。</string>
    <string name="rumi_field_endpoint">覆盖端点</string>
    <string name="rumi_endpoint_required">自定义服务商必填</string>
    <string name="rumi_field_protocol">协议</string>
    <string name="rumi_field_credential">凭据</string>
    <string name="rumi_field_header_name">请求头名称</string>
    <string name="rumi_field_models_path">模型列表路径</string>
    <string name="rumi_models_path_hint">追加到基础 URL 之后。OpenAI 形式的服务器保持 /models。</string>
    <string name="rumi_field_capability">models.dev 服务商键</string>
    <string name="rumi_capability_hint">可选。不填时，模型被视为普通对话模型。</string>
    <string name="rumi_session_header">发送会话 ID</string>
    <string name="rumi_session_header_hint">有些网关要求固定的 x-opencode-session 请求头。</string>
    <string name="rumi_section_snapshots">上下文中保留的快照</string>
    <string name="rumi_snapshots_note">较早的图片会从请求中去掉，它们的文字结果仍会保留。</string>
